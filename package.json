{
  "name": "playwright-typescript-framework-ai",
  "version": "1.0.0",
  "private": true,
  "description": "Web UI + API automation framework cho Book Management (book.anhtester.com) — Playwright TypeScript, Allure 2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node scripts/run-browsers.mjs --with-api",
    "test:ui": "node scripts/run-browsers.mjs",
    "test:ui:chrome": "node scripts/run-browsers.mjs --browsers=chrome",
    "test:ui:edge": "node scripts/run-browsers.mjs --browsers=edge",
    "test:ui:firefox": "node scripts/run-browsers.mjs --browsers=firefox",
    "test:api": "playwright test --project=api",
    "test:book": "node scripts/run-browsers.mjs --suites=ui",
    "test:crm": "node scripts/run-browsers.mjs --suites=crm",
    "test:cms": "node scripts/run-browsers.mjs --suites=cms",
    "test:smoke": "node scripts/run-browsers.mjs --with-api --grep @smoke",
    "test:headed": "node scripts/run-browsers.mjs --browsers=chrome --headed",
    "test:list": "playwright test --list",
    "typecheck": "tsc --noEmit",
    "check:env": "node scripts/check-env.mjs",
    "notify:slack": "node scripts/slack-notify.mjs",
    "report": "node scripts/allure.mjs report",
    "report:generate": "node scripts/allure.mjs generate",
    "report:open": "node scripts/allure.mjs open",
    "report:single": "node scripts/allure.mjs single",
    "report:html": "playwright show-report reports/html",
    "allure": "node scripts/allure.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "allure-commandline": "^2.43.0",
    "allure-js-commons": "^3.12.1",
    "allure-playwright": "^3.12.1",
    "dotenv": "^17.4.2",
    "typescript": "^7.0.2"
  }
}
