# Sao chép file này thành .env rồi điền giá trị. .env đã bị .gitignore chặn — KHÔNG commit.

# ===== Hệ thống cần test =====
BASE_URL=https://book.anhtester.com
API_URL=https://book.anhtester.com

# ===== Tài khoản demo dùng chung (đăng ký tại <BASE_URL>/sign-up) =====
# Chỉ dùng cho test ĐỌC (đăng nhập, xem hồ sơ). Test làm thay đổi tài khoản tự tạo tài khoản riêng.
TEST_EMAIL=
TEST_PASSWORD=

# ===== Perfex CRM (crm.anhtester.com) — project `crm`, module LOGIN =====
CRM_URL=https://crm.anhtester.com
CRM_ADMIN_EMAIL=
CRM_ADMIN_PASSWORD=
# Project Manager — bộ menu rút gọn (CRM_LOGIN_TC_006)
CRM_PM_EMAIL=
CRM_PM_PASSWORD=
# Khách hàng — đăng nhập cổng /login (CRM_LOGIN_TC_019, 020). Để trống thì 2 test tự SKIP
CRM_CUSTOMER_EMAIL=
CRM_CUSTOMER_PASSWORD=
# Staff test có mật khẩu CHỨA CHỮ CÁI (CRM_LOGIN_TC_014) — admin demo mật khẩu toàn số nên không dùng được. Để trống thì SKIP
CRM_TC014_EMAIL=
CRM_TC014_PASSWORD=

# ===== Active eCommerce CMS (cms.anhtester.com) — project `cms`, module LOGIN =====
CMS_URL=https://cms.anhtester.com
# Tài khoản quản trị vai trò staff — đăng nhập ở /login, vào /admin
CMS_ADMIN_EMAIL=
CMS_ADMIN_PASSWORD=

# ===== Chạy test =====
# Số luồng song song — nguồn DUY NHẤT, playwright.config.ts đọc từ đây
WORKERS=5
# Trình duyệt test UI (npm test · test:ui · test:book/crm/cms · test:smoke): chrome · edge · firefox, cách nhau dấu phẩy.
# Để trống = cả 3. Lệnh test:ui:edge / test:ui:firefox vẫn chạy được vì --browsers ghi đè biến này
BROWSERS=chrome
HEADLESS=true
# Timeout mỗi test / mỗi assertion (ms)
TIMEOUT=60000
EXPECT_TIMEOUT=10000
# SLA thời gian phản hồi mỗi API call (ms) — test API assert response nhanh hơn ngưỡng này
API_SLA_MS=2000
# Viewport <rộng>x<cao>. Debug headed trên màn hình 1920x1080 thì đổi thành 1600x750 để cửa sổ không bị cắt
VIEWPORT=1920x1080

# ===== Dữ liệu test & log =====
# Domain email của dữ liệu test sinh ra — nhìn DB là biết bản ghi do automation tạo
TEST_EMAIL_DOMAIN=auto.test
# debug | info | warn | error — log ghi vào reports/logs/execution.log
LOG_LEVEL=info
